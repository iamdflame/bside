# B-Side — environment template. Copy to .env and fill. NEVER commit .env.

# --- Backblaze B2 (required: the system of record) ---
# Create a bucket (private) + an application key scoped to that bucket:
# https://secure.backblaze.com/app_keys.htm
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET=
B2_REGION=            # e.g. us-west-004 (from your bucket's endpoint s3.us-west-004.backblazeb2.com)

# --- Providers (each unlocks a real pipeline stage) ---
ASSEMBLYAI_API_KEY=   # transcription w/ word timings — free credits: assemblyai.com
GEMINI_API_KEY=       # direction (chapters/notes/quotes) + image fallback — free: aistudio.google.com
NVIDIA_API_KEY=       # primary episode art (FLUX) — free credits: build.nvidia.com (optional)
ELEVENLABS_API_KEY=   # trailer voiceover (optional)

# --- App ---
BSIDE_DATA_DIR=./data
BSIDE_PUBLIC_URL=http://localhost:8000
